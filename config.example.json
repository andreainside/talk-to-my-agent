{
  "bot_open_id": "ou_YOUR_BOT_OPEN_ID",
  "owner_open_id": "ou_YOUR_OWN_OPEN_ID",
  "workdir": "~/work/your-repo",
  "workdir_refresh_command": "",
  "context_messages": 40,
  "ack_emoji": "THUMBSUP",
  "executor": {
    "provider": "claude",
    "model": "",
    "effort": ""
  },
  "env_file": "~/.talk-to-my-agent/env",
  "approvals": {
    "enabled": true,
    "timeout_seconds": 300
  },
  "auto_allow_tools": "Read,Grep,Glob,LS,TodoWrite,Task,WebSearch",
  "auto_allow_bash_prefixes": "git log,git show,git diff,git status,git grep,git branch,rg,grep,ls,cat,head,tail,wc,find,cd,echo,pwd,which,sed -n,diff,stat,file,tree,du,sort",
  "claude_args": [],
  "codex_args": [
    "--sandbox",
    "read-only",
    "--skip-git-repo-check"
  ],
  "run_timeout_seconds": 900,
  "groups": [],
  "reply_style": "thread",
  "allowed_read_roots": []
}
